# Copy to .env and fill in the keys:  cp .env.example .env
# Never commit .env (it's already in .gitignore).

# --- Required ---
OPENAI_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

# --- OpenAI models ---
OPENAI_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# --- Pinecone ---
PINECONE_INDEX_NAME=runbook-copilot
PINECONE_NAMESPACE=incident-runbooks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Self-RAG limits ---
TOP_K=5
MAX_SUPPORT_RETRIES=2
MAX_RETRIEVAL_REWRITES=2
MAX_WEB_REWRITES=2

# --- SQLite audit log (relative to the project root) ---
DATABASE_PATH=data/audit.db

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=runbook-copilot
